+/** Coalesce queued work and remove callbacks before the window is released. */
+private class WallpaperBlurHost(private val activity: Activity) {
+    private val decorView = activity.window.decorView
+    private var desiredRadius = 0
+    private var disposed = false
+    private val repaint = Runnable { if (!disposed) decorView.invalidate() }
+    private val reassert = Runnable {
+        if (!disposed) activity.setWallpaperBlurWithoutDim(desiredRadius)
+    }
+    private val focusListener = ViewTreeObserver.OnWindowFocusChangeListener { hasFocus ->
+        if (hasFocus && !disposed) activity.setWallpaperBlurWithoutDim(desiredRadius)
+    }
+
+    fun attach() {
+        decorView.viewTreeObserver.addOnWindowFocusChangeListener(focusListener)
+    }
+
+    fun update(radius: Int) {
+        if (disposed) return
+        desiredRadius = radius
+        activity.setWallpaperBlurWithoutDim(radius)
+        // Keep the existing OEM blur recovery. Only stale queued requests are removed.
+        decorView.removeCallbacks(repaint)
+        decorView.removeCallbacks(reassert)
+        decorView.postOnAnimation(repaint)
+        if (radius > 0) decorView.post(reassert)
+    }
+
+    fun dispose() {
+        disposed = true
+        decorView.removeCallbacks(repaint)
+        decorView.removeCallbacks(reassert)
+        val observer = decorView.viewTreeObserver
+        if (observer.isAlive) observer.removeOnWindowFocusChangeListener(focusListener)
+        activity.setWallpaperBlurWithoutDim(0)
+    }
+}
